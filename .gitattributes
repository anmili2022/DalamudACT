# Auto detect text files and perform normalization.
* text=auto

# Keep source and documentation files stable across Windows/macOS/Linux.
*.md text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
